#!/bin/bash
# Voice Ledger Launcher — double-click entry point, no Terminal required.
#
# Starts the backend and the local voice-service (each if not already
# running) and launches the desktop app's already-built binary (if not
# already running), and shows a native macOS dialog summarizing what
# happened. Safe to double-click again any time — it detects what's
# already running and skips redundant work, and detects a port conflict
# (something else already listening on 3000 or 8790) rather than silently
# trying to start a second instance on top of it.
#
# Deliberately does NOT build anything itself — see the desktop-app
# section below for why `swift build` specifically cannot run reliably
# from here.
#
# GUI-launched processes on macOS do NOT source ~/.zshrc or ~/.bash_profile,
# so PATH is set explicitly here — without this, node/npm/swift would not
# be found even though they work fine from an interactive Terminal.
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

PROJECT_ROOT="/Users/benjaminkylebranson/Documents/Bookkeeping APP"
BACKEND_DIR="$PROJECT_ROOT/backend"
DESKTOP_DIR="$PROJECT_ROOT/desktop"
VOICE_SERVICE_DIR="$PROJECT_ROOT/voice-service"
BACKEND_PORT=3000
VOICE_SERVICE_PORT=8790

LOG_DIR="$HOME/Library/Logs/VoiceLedger"
mkdir -p "$LOG_DIR"
BACKEND_LOG="$LOG_DIR/backend.log"
APP_LOG="$LOG_DIR/app.log"
VOICE_SERVICE_LOG="$LOG_DIR/voice-service.log"

# A double-click while a previous launch is still deciding what to do
# (e.g. mid-way through the backend health poll below) would otherwise
# race itself and could start two backends. This lock makes a second,
# concurrent double-click a silent no-op instead.
LOCK_FILE="$LOG_DIR/launcher.lock"
if [ -f "$LOCK_FILE" ] && kill -0 "$(cat "$LOCK_FILE" 2>/dev/null)" 2>/dev/null; then
    exit 0
fi
echo $$ > "$LOCK_FILE"
trap 'rm -f "$LOCK_FILE"' EXIT

# A directly reopened app can request recovery. Wait for that exact app
# process to exit before the existing already-running check below.
RECOVERY_REQUESTED=false
if [[ "${VOICE_LEDGER_RELAUNCH_PID:-}" =~ ^[0-9]+$ ]]; then
    RECOVERY_REQUESTED=true
    for _ in $(seq 1 30); do
        kill -0 "$VOICE_LEDGER_RELAUNCH_PID" 2>/dev/null || break
        sleep 0.2
    done
    # SwiftUI/AppKit can leave the error-only window process alive after
    # terminate() was requested. This PID came from that app instance itself,
    # so finish its graceful shutdown before the already-running check.
    if kill -0 "$VOICE_LEDGER_RELAUNCH_PID" 2>/dev/null; then
        kill -TERM "$VOICE_LEDGER_RELAUNCH_PID" 2>/dev/null || true
        for _ in $(seq 1 20); do
            kill -0 "$VOICE_LEDGER_RELAUNCH_PID" 2>/dev/null || break
            sleep 0.1
        done
    fi
    # LaunchServices may immediately reopen the app while restoring its
    # window. That instance has no session either, so clear it before writing
    # the handoff file and opening the fresh, configured instance below.
    pkill -TERM -x VoiceLedgerApp 2>/dev/null || true
    for _ in $(seq 1 20); do
        pgrep -x VoiceLedgerApp >/dev/null 2>&1 || break
        sleep 0.1
    done
fi
unset VOICE_LEDGER_RELAUNCH_PID

status_lines=()
# Owner directive (2026-08-29): the status dialog at the end used to show
# every single launch, even a fully successful one — stealing focus and
# requiring a click before the app window itself could come forward. Only
# genuinely worth an interruption when something needs the owner's
# attention (a port conflict, a timeout, a missing build); a normal
# successful launch is now silent.
has_problem=false

backend_healthy() {
    curl -s -m 2 "http://localhost:$BACKEND_PORT/healthz" 2>/dev/null | grep -q '"status":"ok"'
}

# --- 1. Backend: already running, port conflict, or start it fresh ---
if backend_healthy; then
    status_lines+=("Backend: already running (port $BACKEND_PORT)")
elif lsof -i ":$BACKEND_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    # Something is listening on the port but didn't answer as Voice
    # Ledger's own backend — a real conflict, not something to paper over
    # by trying to start a second server on the same port.
    OWNER="$(lsof -i ":$BACKEND_PORT" -sTCP:LISTEN 2>/dev/null | awk 'NR==2 {print $1" (pid "$2")"}')"
    status_lines+=("Port $BACKEND_PORT is already in use by ${OWNER:-another process}, and it did not answer as Voice Ledger's backend. Quit that process, then open this launcher again.")
    has_problem=true
else
    cd "$BACKEND_DIR" || { status_lines+=("Backend: could not find $BACKEND_DIR"); has_problem=true; }
    if [ -d "$BACKEND_DIR" ]; then
        : > "$BACKEND_LOG"
        # `arch -arm64` forces native execution regardless of any ambient
        # Rosetta translation state a GUI-launched process can inherit —
        # confirmed live: without this, node ran as x86_64 here and failed
        # to load better-sqlite3's arm64-only native module, even though
        # the identical `npm run dev` works fine from an interactive
        # Terminal shell.
        nohup arch -arm64 npm run dev >> "$BACKEND_LOG" 2>&1 &
        disown
        started=false
        # 45s, not 20 — confirmed live that a busy Mac (other node/npm
        # processes already running) can make `npm run dev` take noticeably
        # longer to come up than on an idle machine.
        for _ in $(seq 1 45); do
            sleep 1
            if backend_healthy; then started=true; break; fi
        done
        if [ "$started" = true ]; then
            status_lines+=("Backend: started (port $BACKEND_PORT)")
        else
            status_lines+=("Backend: did not respond after 45s — check ~/Library/Logs/VoiceLedger/backend.log")
            has_problem=true
        fi
    fi
fi

# --- 2. voice-service: already running, port conflict, or start it fresh ---
# docs/VOICE_LEDGER_SPEC.md's /voice module. Same three-way shape as the
# backend section above (already healthy / port conflict / start fresh),
# and the same "does not build/set up anything itself" posture the
# desktop-app section documents below — first-time `pip install`/model
# download is a one-time setup step, not something a double-click should
# attempt silently in the background.
voice_service_healthy() {
    curl -s -m 2 "http://localhost:$VOICE_SERVICE_PORT/health" 2>/dev/null | grep -q '"status":"ok"'
}

if voice_service_healthy; then
    status_lines+=("Voice service: already running (port $VOICE_SERVICE_PORT)")
elif lsof -i ":$VOICE_SERVICE_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    OWNER="$(lsof -i ":$VOICE_SERVICE_PORT" -sTCP:LISTEN 2>/dev/null | awk 'NR==2 {print $1" (pid "$2")"}')"
    status_lines+=("Port $VOICE_SERVICE_PORT is already in use by ${OWNER:-another process}, and it did not answer as Voice Ledger's voice service. Quit that process, then open this launcher again.")
    has_problem=true
elif [ ! -x "$VOICE_SERVICE_DIR/.venv/bin/python" ]; then
    status_lines+=("Voice service: not set up yet. Ask Claude to run \"uv venv --python 3.12 .venv && uv pip install --python .venv/bin/python -r requirements.txt && ./download_voice.sh\" in the voice-service folder once, then open this launcher again. Voice commands won't work until then, but the rest of the app will.")
    has_problem=true
else
    : > "$VOICE_SERVICE_LOG"
    # Absolute paths throughout, not a `cd` + relative path — confirmed
    # live that `arch -arm64` combined with `nohup ... &` inside a
    # subshell can fail to resolve a relative interpreter path
    # ("realpath failed") even though the `cd` runs first in the same
    # subshell; absolute paths sidestep the question entirely.
    (cd "$VOICE_SERVICE_DIR" && nohup arch -arm64 "$VOICE_SERVICE_DIR/.venv/bin/python" -m uvicorn main:app --host 127.0.0.1 --port "$VOICE_SERVICE_PORT" >> "$VOICE_SERVICE_LOG" 2>&1 &)
    started=false
    # Loading faster-whisper + Piper's models takes a few real seconds
    # (live-verified 2026-08-29: ~2-3s on this machine) — 30s leaves
    # comfortable headroom on a busier or colder-cache machine, same
    # generous-timeout reasoning the backend section above already uses.
    for _ in $(seq 1 30); do
        sleep 1
        if voice_service_healthy; then started=true; break; fi
    done
    if [ "$started" = true ]; then
        status_lines+=("Voice service: started (port $VOICE_SERVICE_PORT)")
    else
        status_lines+=("Voice service: did not respond after 30s — check ~/Library/Logs/VoiceLedger/voice-service.log. Voice commands won't work until this is running, but the rest of the app will.")
        has_problem=true
    fi
fi

# --- 3. Desktop app: already running, or launch the pre-built binary ---
#
# Deliberately does NOT run `swift build` here. Confirmed live (2026-08-28):
# `swift build`'s manifest-evaluation step runs inside SwiftPM's own
# internal sandbox (Seatbelt), which is sensitive to the exact temp-
# directory/session context a GUI double-click provides in a way that
# differs from an interactive Terminal session — it failed with "couldn't
# determine the current working directory" / "Operation not permitted"
# specifically when launched via double-click, on both the developer's
# machine and the owner's. This is NOT a Files & Folders / Full Disk
# Access permission (confirmed: it never appears in either list, because
# it isn't that kind of restriction) — there is no System Settings fix
# for it. The actual fix is architectural: whoever maintains this app
# builds it (already-working `swift build -c release` from a Terminal
# session, or Claude Code running it), and this launcher's only job is to
# run the binary that build already produced.
if pgrep -x VoiceLedgerApp >/dev/null 2>&1 && [ "$RECOVERY_REQUESTED" = false ]; then
    status_lines+=("Voice Ledger app: already running")
else
    # Runs the app from a real .app bundle (Contents/MacOS +
    # Contents/Info.plist), not the bare Mach-O. See
    # scripts/build-app-bundle.sh's own header comment for the full
    # history of why the bundle exists at all.
    #
    # ROOT CAUSE FOUND AND FIXED 2026-08-29: wrapping the binary in a real
    # .app bundle was necessary but NOT sufficient — this section used to
    # launch it with `nohup "$BIN" ... &`, executing the Mach-O directly
    # instead of going through `open`/LaunchServices. That bypasses the
    # normal macOS app-launch path entirely: the process comes up without
    # a real WindowGroup-hosting session, which reproduced as TWO distinct,
    # confirmed-live symptoms — (1) the app sometimes opens with ZERO
    # windows at all (confirmed via `osascript`'s window count reporting 0
    # immediately after launch, repeatably), and (2) when a window DID
    # appear, pressing any SwiftUI `Button` could SIGABRT inside SwiftUI's
    # own gesture dispatch (`MainActor.assumeIsolated` failing on the
    # actual main thread — two real crash reports from tonight,
    # `~/Library/Logs/DiagnosticReports/VoiceLedgerApp-2026-08-29-*.ips`,
    # confirm the identical signature). The `.onAppear { NSApp
    # .setActivationPolicy(.regular) }` workaround in VoiceLedgerApp.swift
    # papered over this sometimes but not reliably, because it can only
    # run AFTER a window already exists — it can't fix a launch that never
    # produces a window at all.
    #
    # Fixed by launching via `open -a` instead, which routes through
    # LaunchServices and gives the process a normal, foreground GUI-app
    # session — the same path a Dock/Finder double-click uses. Verified
    # live: repeated launches all produced a real window immediately (vs.
    # 0/2 for the old `nohup` path just before this fix), and 9 real
    # SwiftUI button presses via accessibility automation produced zero
    # crashes afterward. `open` doesn't inherit the calling shell's
    # environment the way `nohup`/`&` did, so the env vars this app needs
    # are passed explicitly via `--env` instead; `--stdout`/`--stderr`
    # preserve the existing log-file behavior.
    #
    # Assembling the bundle (scripts/build-app-bundle.sh) does NOT happen
    # here, even though it's cheap (just cp/codesign, no SwiftPM manifest
    # evaluation) — confirmed live (2026-08-29) it still fails with
    # "Operation not permitted" from this GUI-launched context, the same
    # class of sandboxing restriction already documented above for
    # `swift build` itself. Same fix: this launcher only ever RUNS a
    # pre-built bundle, never builds or assembles one — whoever maintains
    # this app runs build-app-bundle.sh from a Terminal session (or Claude
    # Code) after `swift build -c release`.
    APP_BUNDLE="$DESKTOP_DIR/.build/release/VoiceLedgerApp.app"
    BIN="$APP_BUNDLE/Contents/MacOS/VoiceLedgerApp"
    if [ ! -x "$BIN" ]; then
        status_lines+=("Voice Ledger app: not built yet. Ask Claude to run \"swift build -c release && ./scripts/build-app-bundle.sh release\" in the desktop folder once, then open this launcher again — it will find and run it from then on without needing to build again.")
        has_problem=true
    else
        : > "$APP_LOG"
        # The app needs a backend URL, a session token, and which connected
        # company (realmId) to open — it has no way to guess these itself.
        # The realmId/environment come from whatever's already connected
        # (backend/data/voiceledger.sqlite's `connections` table, the same
        # source of truth the backend itself uses) rather than a value
        # hardcoded here, so reconnecting a different company later doesn't
        # require editing this script. The session token is minted fresh
        # each launch via the project's own dev helper
        # (backend/spike/mintDevSession.ts) — the same mechanism used
        # throughout this project's own live-verification testing — since a
        # session token is single-use-to-read (only its hash is ever
        # stored) and can't just be read back from somewhere.
        # Deliberately node/tsx, not the system `sqlite3` CLI — confirmed
        # live that `sqlite3` hits "authorization denied" reading this
        # exact file from this exact launch context even though `node`
        # (already proven working for the backend itself, above) does not.
        # Keep the helper's working directory out of macOS's protected
        # Documents tree. tsx calls getcwd() during startup, which can block
        # indefinitely in the GUI-launch context even though Terminal works.
        CONNECTION_INFO="$(cd /tmp && DOTENV_CONFIG_PATH="$BACKEND_DIR/.env" SQLITE_PATH="$BACKEND_DIR/data/voiceledger.sqlite" arch -arm64 "$BACKEND_DIR/node_modules/.bin/tsx" "$BACKEND_DIR/spike/latestConnection.ts" 2>>"$APP_LOG")"
        REALM_ID="$(echo "$CONNECTION_INFO" | sed -n '1p')"
        REALM_ENV="$(echo "$CONNECTION_INFO" | sed -n '2p')"
        [ -z "$REALM_ENV" ] && REALM_ENV="sandbox"

        if [ -z "$REALM_ID" ]; then
            status_lines+=("Voice Ledger app: no connected company found yet. Connect one first, then open this launcher again.")
            has_problem=true
        else
            SESSION_TOKEN_FILE="$LOG_DIR/session-token.txt"
            rm -f "$SESSION_TOKEN_FILE"
            (cd /tmp && DOTENV_CONFIG_PATH="$BACKEND_DIR/.env" SQLITE_PATH="$BACKEND_DIR/data/voiceledger.sqlite" arch -arm64 "$BACKEND_DIR/node_modules/.bin/tsx" "$BACKEND_DIR/spike/mintDevSession.ts" "$REALM_ID" "$SESSION_TOKEN_FILE") >> "$APP_LOG" 2>&1
            SESSION_TOKEN="$(cat "$SESSION_TOKEN_FILE" 2>/dev/null)"
            rm -f "$SESSION_TOKEN_FILE"

            if [ -z "$SESSION_TOKEN" ]; then
                status_lines+=("Voice Ledger app: could not create a session for the connected company — check ~/Library/Logs/VoiceLedger/app.log")
                has_problem=true
            else
                # LaunchServices drops --env values on this macOS version.
                # Pass the one-launch session through a private file instead;
                # Voice Ledger reads and removes it immediately at startup.
                LAUNCH_CONFIG="$LOG_DIR/launch-config.json"
                umask 077
                printf '{"backendURL":"http://localhost:%s","sessionToken":"%s","realmID":"%s","environment":"%s"}\n' \
                    "$BACKEND_PORT" "$SESSION_TOKEN" "$REALM_ID" "$REALM_ENV" > "$LAUNCH_CONFIG"
                chmod 600 "$LAUNCH_CONFIG"
                # `arch -arm64` intentionally NOT used here (unlike the
                # backend/voice-service sections above) — this machine and
                # this binary are both already native arm64, so it would be
                # a no-op; the real fix for the crash this section used to
                # carry a long comment about was launching via `open`
                # instead of `nohup`, see this block's header comment.
                #
                # `open` does not inherit the calling shell's environment
                # the way `nohup ... &` did, so the four env vars this app
                # needs are passed explicitly via `--env`. `--stdout`/
                # `--stderr` preserve the same log file the old `nohup ...
                # >> "$APP_LOG" 2>&1` redirect produced.
                # Explicitly request a fresh process so LaunchServices applies
                # these per-launch credentials instead of reusing an app
                # instance that may have been opened directly without them.
                open -n -a "$APP_BUNDLE" \
                    --env VOICE_LEDGER_BACKEND_URL="http://localhost:$BACKEND_PORT" \
                    --env VOICE_LEDGER_SESSION_TOKEN="$SESSION_TOKEN" \
                    --env VOICE_LEDGER_REALM_ID="$REALM_ID" \
                    --env VOICE_LEDGER_ENVIRONMENT="$REALM_ENV" \
                    --stdout "$APP_LOG" --stderr "$APP_LOG"
                status_lines+=("Voice Ledger app: launched")
            fi
        fi
    fi
fi

# --- 4. Show a native status dialog ONLY when something needs attention ---
# A fully successful launch (backend/voice-service already healthy or
# started cleanly, app launched or already running) is silent — the app
# window itself is the confirmation. The dialog used to show every single
# time, stealing focus and requiring a click before the real window could
# come forward, which is exactly backwards for the common case.
if [ "$has_problem" = true ]; then
    MESSAGE="$(printf '%s\n' "${status_lines[@]}")"
    osascript \
        -e 'on run argv' \
        -e 'display dialog (item 1 of argv) with title "Voice Ledger" buttons {"OK"} default button "OK" with icon caution' \
        -e 'end run' \
        "$MESSAGE" >/dev/null 2>&1
fi
