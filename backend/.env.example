# Copy to .env for local development (npm run dev loads it via tsx's
# built-in .env support / your shell). NEVER commit a real .env — the root
# .gitignore already excludes .env* broadly, on purpose.
#
# For Render: set these as environment variables in the Render dashboard,
# not in a committed file. See backend/README.md.

# --- Server ---
PORT=3000
APP_BASE_URL=http://localhost:3000

# --- QBO sandbox app credentials ---
# From developer.intuit.com, after creating an app and a sandbox company.
# docs/phase-0/03_SECURITY_THREAT_MODEL.md §3.8 control 1: sandbox and
# production use DIFFERENT client IDs. This backend can only ever mint a
# sandbox token unless ALLOW_PRODUCTION=true AND the QBO_PRODUCTION_*
# variables below are also set — see src/config.ts.
QBO_SANDBOX_CLIENT_ID=
QBO_SANDBOX_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/oauth/callback
QBO_MINOR_VERSION=75

# --- Production QBO credentials (leave unset in every dev/CI environment) ---
# ALLOW_PRODUCTION=true
# QBO_PRODUCTION_CLIENT_ID=
# QBO_PRODUCTION_CLIENT_SECRET=

# --- Token encryption ---
# 32 bytes, hex-encoded (64 hex characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Storage ---
# Phase 1 step 1.2 scope: local SQLite file. See src/db/sqlite.ts's doc
# comment for why this is an explicit, temporary scope decision.
SQLITE_PATH=./data/voiceledger.sqlite

# --- Future write-path flag (unused in Phase 1 step 1.2 — no write
# operation exists in the catalog yet; recorded now so the control exists
# before it's needed) ---
# ALLOW_PRODUCTION_WRITES=false

# --- Spike harness only (backend/spike/, not the production server) ---
# Set after connecting a sandbox company via /oauth/authorize.
QBO_SPIKE_REALM_ID=

# --- OpenAI (Ask [AI] panel) ---
# From platform.openai.com/api-keys. Optional — the app runs fully without
# it; AI features just report as unconfigured (/ai/status) and stay off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
