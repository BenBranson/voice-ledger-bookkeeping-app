{
  "name": "voice-ledger-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Voice Ledger's thin backend — OAuth, session, and the fixed QBO operation catalog. Phase 1 step 1.2 scope: read operations only. See docs/phase-0/03_SECURITY_THREAT_MODEL.md.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "spike": "tsx spike/run.ts",
    "spike:seed": "tsx spike/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^3.0.0"
  }
}
